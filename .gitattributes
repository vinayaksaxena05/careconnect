# Normalise line endings: text files stored with LF in the repo.
* text=auto eol=lf

# Windows scripts keep CRLF on checkout.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Shell scripts always LF.
*.sh text eol=lf

# Binary assets - never touch line endings, never try to diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.joblib binary
*.pkl   binary
*.pickle binary
*.csv.gz binary
